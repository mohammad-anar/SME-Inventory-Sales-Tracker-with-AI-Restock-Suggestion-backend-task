NODE_ENV=development
PORT=4001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockpilot?schema=public"

BCRYPT_SALT_ROUND=10
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE_IN=1d
JWT_REFRESH_EXPIRE_IN=30d

REDIS_URL="redis://localhost:6379"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_FROM=your_email@gmail.com
EMAIL_PASS=your_email_app_password

FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Super Admin Seed Credentials (Optional for Initial DB Seed)
NAME="Super Admin"
EMAIL=admin@example.com
PHONE=01700000000
PASSWORD=your_admin_password
AVATAR=https://example.com/avatar.jpg
